{
  "name": "solar-soundtrack",
  "version": "0.0.0",
  "description": "Browser-based AddmusicK MML editor — compiles MML to N-SPC song data",
  "private": true,
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "start": "npm start -w web",
    "build": "npm run build -w web",
    "watch": "npm run watch -w web",
    "build:worklet": "npm run build -w @amk/spc",
    "sync-spc-assets": "node scripts/sync-spc-assets.mjs",
    "prepare:assets": "npm run build:worklet && npm run sync-spc-assets",
    "generate-git-info": "node scripts/generate-git-info.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prelint": "npm run generate-git-info",
    "lint": "eslint . --max-warnings 0",
    "prelint:fix": "npm run generate-git-info",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "typecheck": "npm run typecheck -w web",
    "typecheck:packages": "tsc -p packages/core && tsc -p packages/mml-compiler && tsc -p packages/spc && tsc -p packages/mml-tokens",
    "typecheck:scripts": "tsc -p scripts",
    "selftest": "esbuild scripts/selftest.ts --bundle --platform=node --format=esm --outfile=.selftest/selftest.mjs --log-level=warning && node .selftest/selftest.mjs",
    "spctest": "esbuild scripts/spctest.ts --bundle --platform=node --format=esm --outfile=.selftest/spctest.mjs --log-level=warning && node .selftest/spctest.mjs",
    "audiotest": "esbuild scripts/audiotest.ts --bundle --platform=node --format=esm --outfile=.selftest/audiotest.mjs --log-level=warning && node .selftest/audiotest.mjs",
    "worklettest": "npm run build:worklet && esbuild scripts/worklettest.ts --bundle --platform=node --format=esm --outfile=.selftest/worklettest.mjs --log-level=warning && node .selftest/worklettest.mjs",
    "charttest": "esbuild scripts/charttest.ts --bundle --platform=node --format=esm --outfile=.selftest/charttest.mjs --log-level=warning && node .selftest/charttest.mjs",
    "brrtest": "esbuild scripts/brrtest.ts --bundle --platform=node --format=esm --outfile=.selftest/brrtest.mjs --log-level=warning && node .selftest/brrtest.mjs",
    "tokentest": "esbuild scripts/tokentest.ts --bundle --platform=node --format=esm --outfile=.selftest/tokentest.mjs --log-level=warning && node .selftest/tokentest.mjs",
    "firtest": "esbuild scripts/firtest.ts --bundle --platform=node --format=esm --outfile=.selftest/firtest.mjs --log-level=warning && node .selftest/firtest.mjs",
    "instrtest": "esbuild scripts/instrtest.ts --bundle --platform=node --format=esm --outfile=.selftest/instrtest.mjs --log-level=warning && node .selftest/instrtest.mjs",
    "adsrtest": "esbuild scripts/adsrtest.ts --bundle --platform=node --format=esm --outfile=.selftest/adsrtest.mjs --log-level=warning && node .selftest/adsrtest.mjs",
    "edittest": "esbuild scripts/edittest.ts --bundle --platform=node --format=esm --outfile=.selftest/edittest.mjs --log-level=warning && node .selftest/edittest.mjs",
    "walktest": "esbuild scripts/walktest.ts --bundle --platform=node --format=esm --outfile=.selftest/walktest.mjs --log-level=warning && node .selftest/walktest.mjs",
    "palettetest": "esbuild scripts/palettetest.ts --bundle --platform=node --format=esm --outfile=.selftest/palettetest.mjs --log-level=warning && node .selftest/palettetest.mjs",
    "check:compiler": "npm run selftest",
    "check:tokens": "npm run tokentest && npm run edittest && npm run palettetest",
    "check:spc": "npm run adsrtest && npm run instrtest && npm run brrtest && npm run firtest",
    "check:integration": "npm run spctest && npm run audiotest && npm run worklettest && npm run walktest",
    "rolltest": "esbuild scripts/rolltest.ts --bundle --platform=node --format=esm --outfile=.selftest/rolltest.mjs --log-level=warning && node .selftest/rolltest.mjs",
    "check:app": "npm run charttest && npm run rolltest",
    "check": "npm run format:check && npm run typecheck && npm run typecheck:packages && npm run typecheck:scripts && npm run check:compiler && npm run check:tokens && npm run check:spc && npm run check:integration && npm run check:app"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.3",
    "@types/node": "^26.1.2",
    "angular-eslint": "22.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1"
  }
}
