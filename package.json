{
  "name": "solar-soundtrack",
  "version": "0.0.0",
  "description": "Browser-based AddmusicK MML editor — compiles MML to N-SPC song data",
  "private": true,
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "start": "npm start -w web",
    "start:ids": "npm run start:ids -w web",
    "build": "npm run build -w web",
    "watch": "npm run watch -w web",
    "build:worklet": "npm run build -w @amk/spc",
    "sync-spc-assets": "node scripts/sync-spc-assets.mjs",
    "prepare:assets": "npm run build:worklet && npm run sync-spc-assets",
    "generate-git-info": "node scripts/generate-git-info.mjs",
    "i18n": "npm run extract-i18n -w web && node scripts/i18n-catalog.mjs write",
    "i18n:check": "npm run extract-i18n -w web && node scripts/i18n-catalog.mjs check",
    "codemap": "node scripts/codemap.mjs write",
    "codemap:check": "node scripts/codemap.mjs check",
    "citations:check": "node scripts/citations.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prelint": "npm run generate-git-info",
    "lint": "eslint . --max-warnings 0",
    "prelint:fix": "npm run generate-git-info",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "typecheck": "npm run typecheck -w web",
    "typecheck:packages": "tsc -p packages/core && tsc -p packages/mml-compiler && tsc -p packages/spc && tsc -p packages/mml-tokens && tsc -p packages/song-import",
    "typecheck:scripts": "tsc -p scripts",
    "selftest": "node scripts/run-harness.mjs selftest",
    "tokentest": "node scripts/run-harness.mjs tokentest",
    "edittest": "node scripts/run-harness.mjs edittest",
    "palettetest": "node scripts/run-harness.mjs palettetest",
    "adsrtest": "node scripts/run-harness.mjs adsrtest",
    "instrtest": "node scripts/run-harness.mjs instrtest",
    "brrtest": "node scripts/run-harness.mjs brrtest",
    "firtest": "node scripts/run-harness.mjs firtest",
    "spctest": "node scripts/run-harness.mjs spctest",
    "audiotest": "node scripts/run-harness.mjs audiotest",
    "worklettest": "npm run build:worklet && node scripts/run-harness.mjs worklettest",
    "walktest": "node scripts/run-harness.mjs walktest",
    "charttest": "node scripts/run-harness.mjs charttest",
    "pianorolltest": "node scripts/run-harness.mjs pianorolltest",
    "fixtest": "node scripts/run-harness.mjs fixtest",
    "miditest": "node scripts/run-harness.mjs miditest",
    "modtest": "node scripts/run-harness.mjs modtest",
    "s3mtest": "node scripts/run-harness.mjs s3mtest",
    "xmtest": "node scripts/run-harness.mjs xmtest",
    "check:compiler": "npm run selftest",
    "check:tokens": "npm run tokentest && npm run edittest && npm run palettetest",
    "check:spc": "npm run adsrtest && npm run instrtest && npm run brrtest && npm run firtest",
    "check:integration": "npm run spctest && npm run audiotest && npm run worklettest && npm run walktest && npm run miditest && npm run modtest && npm run s3mtest && npm run xmtest",
    "check:app": "npm run charttest && npm run pianorolltest && npm run fixtest",
    "check": "node scripts/check.mjs",
    "affected": "node scripts/affected.mjs",
    "ci": "npm run lint && npm run check && npm run build",
    "drive": "node scripts/drive/drive.mjs",
    "drive:serve": "node scripts/drive/serve.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.3",
    "@types/node": "^26.1.2",
    "angular-eslint": "22.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1"
  }
}
