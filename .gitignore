# Local reference copies of AddmusicK 1.0.11's sources and readme. The compiler
# cites them by line number; fetch them from an AddmusicK release.
AddmusicKsrc/
AddmusicKreadme/

# Claude Code. The guidance, rules, hooks, shared settings and project skills are
# checked in so a fresh clone gets them; machine-local permissions and the skills
# the Angular CLI installs stay out.
**/.claude/*
!**/.claude/CLAUDE.md
!/.claude/rules/
!/.claude/hooks/
!/.claude/settings.json
!/.claude/skills/
/.claude/skills/angular-*/

# Node. One install at the root serves every workspace.
node_modules/
npm-debug.log
yarn-error.log

# Bundles the harnesses build before running.
/.selftest

# `mdbook build docs/book` output; CI builds the guide into the app's dist instead.
/docs/book/book/

# generated by `npm run build:worklet`
/packages/spc/assets/player/spc-worklet.js

# System files
.DS_Store
Thumbs.db
