# Local reference copies of AddmusicK 1.0.11's sources and readme. The compiler
# cites them by line number; fetch them from an AddmusicK release.
AddmusicKsrc/
AddmusicKreadme/

# Claude Code. Machine-local permissions and installed skills stay out; the
# CLAUDE.md guidance files are checked in so a fresh clone gets them.
**/.claude/*
!**/.claude/CLAUDE.md

# Node. One install at the root serves every workspace.
node_modules/
npm-debug.log
yarn-error.log

# Bundles the harnesses build before running.
/.selftest

# generated by `npm run build:worklet`
/packages/spc/assets/player/spc-worklet.js

# System files
.DS_Store
Thumbs.db
