{
  "printWidth": 100,
  "singleQuote": true,
  "endOfLine": "auto",
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "parser": "angular"
      }
    },
    {
      "files": ["COMMANDS.html", "README.html"],
      "options": {
        "parser": "html"
      }
    },
    {
      "files": ["packages/**/*.ts", "scripts/**/*.ts"],
      "options": {
        "useTabs": true,
        "singleQuote": false,
        "printWidth": 120
      }
    }
  ]
}
