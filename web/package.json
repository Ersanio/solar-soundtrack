{
  "name": "web",
  "version": "0.0.0",
  "description": "The Angular editor. Everything it compiles, assembles and plays lives in packages/",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "prestart": "npm run prepare:assets --prefix .. && npm run generate-git-info --prefix ..",
    "prebuild": "npm run prepare:assets --prefix .. && npm run generate-git-info --prefix ..",
    "prewatch": "npm run prepare:assets --prefix .. && npm run generate-git-info --prefix ..",
    "pretypecheck": "npm run generate-git-info --prefix .."
  },
  "dependencies": {
    "@amk/compiler": "*",
    "@amk/core": "*",
    "@amk/spc": "*",
    "@amk/tokens": "*",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/service-worker": "22.0.8",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@lezer/highlight": "^1.2.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@tailwindcss/postcss": "^4.1.12",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12"
  }
}
