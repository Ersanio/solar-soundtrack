{
  "printWidth": 100,
  "singleQuote": true,
  "endOfLine": "auto",
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "parser": "angular"
      }
    },
    {
      "files": ["src/compiler/**/*.ts", "src/spc/**/*.ts", "src/core/**/*.ts", "scripts/**/*.ts"],
      "options": {
        "useTabs": true,
        "singleQuote": false,
        "printWidth": 120
      }
    }
  ]
}
